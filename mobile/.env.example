# Public client config only. Anything secret belongs in backend/.env.
# EXPO_PUBLIC_* values are embedded in the app bundle and are readable by anyone.

# FastAPI base URL. Use your machine's LAN IP (not localhost) when testing on a device.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000
EXPO_PUBLIC_WEB_BASE_URL=http://192.168.1.10:4173
# Optional during migration: accept QR links created on the previous browser host.
# EXPO_PUBLIC_LEGACY_WEB_BASE_URL=https://old-browser.example.org

# Supabase project. The anon key is public by design and gated by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
