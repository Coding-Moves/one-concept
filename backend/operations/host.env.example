# Copy to /etc/one-concept/host.env (root:root 0600). Public values only.
# Supply a hostname you control; no domain purchase is required by this PR.
API_HOST=api.your-approved-host.example
TLS_EMAIL=you@example.org
# Resolve the reviewed Caddy release to its real digest; no mutable production tag.
CADDY_IMAGE=docker.io/library/caddy@sha256:REPLACE_WITH_VERIFIED_DIGEST
