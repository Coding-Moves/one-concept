# Copy to backend/.env and fill in. NEVER commit the filled-in file.
# Everything here is server-side only — none of it may reach the mobile bundle.

ENVIRONMENT=development
LOG_LEVEL=info

# --- Supabase -------------------------------------------------------------
# Settings → Database → Connection string (use the pooler URI in production).
# Transaction-mode pooler (port 6543). Note: a `?pgbouncer=true` suffix is a
# Prisma convention — config.py strips it, since asyncpg rejects it.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Session-mode pooler (port 5432). Used for migrations and any DDL.
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Settings → API
SUPABASE_URL=https://PROJECT.supabase.co
# Full RLS bypass. Treat like a root password: never log it, never ship it.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 secret. Unused when the project signs asymmetrically (ES256),
# which is verified via the JWKS URL below.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# --- Gemini ---------------------------------------------------------------
# The reason this backend exists: the key stays here, never in the app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Kill switch and safety rails for the Phase 6 generation worker.
GENERATION_ENABLED=false
MIN_POOL_PER_TOPIC=25
GENERATION_DAILY_CALL_CAP=200

# --- HTTP -----------------------------------------------------------------
# Comma-separated. Expo web dev server during development.
ALLOWED_ORIGINS=http://localhost:8081
